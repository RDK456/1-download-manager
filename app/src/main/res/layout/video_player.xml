<?xml version="1.0" encoding="utf-8"?>
<!-- The video view for VideoSurface. A TextureView rather than PlayerView's default
     SurfaceView: a SurfaceView under Compose overlays shows torn, striped frames and hides
     the controls drawn above it. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:show_buffering="never"
    app:keep_content_on_player_reset="true"
    app:shutter_background_color="@android:color/black" />
