<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher background: the app's Material indigo (Aurora, #4F5BD5), lighter at the top left.

  Full bleed with no corners on purpose: the launcher supplies its own mask, and
  corners drawn into a vector that is about to be masked show as a double edge on
  some devices. The Windows icon draws its own rounded square in the same two
  colours, because nothing masks a desktop shortcut.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF7480F0"
                android:endColor="#FF3F4AB8" />
        </aapt:attr>
    </path>
</vector>
