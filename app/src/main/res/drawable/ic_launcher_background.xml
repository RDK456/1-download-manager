<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher background: solid black.

  The rounded square is not drawn here on purpose. The launcher supplies its own
  mask, so a full-bleed background becomes the icon's shape on every launcher, and
  drawing corners into a vector that is about to be masked produces a double edge
  that shows on some devices and not others.

  The matching Windows icon does draw its own rounded square, because nothing masks
  a desktop shortcut. Both come from the same artwork; see
  desktop/dist-tools/Generate-AppIcon.ps1.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
