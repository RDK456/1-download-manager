# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio
.idea/
*.iml
local.properties

# Generated / machine-specific
.externalNativeBuild/
.cxx/
*.hprof

# OS
.DS_Store
Thumbs.db

# Build artifacts
# Both installers are copied to the repository root as release assets, and both are
# well over GitHub's 100 MB limit, so they must never be committed.
*.apk
*.msi
*.zip

# Release signing material - keep the keystore and its passwords out of git.
# Losing these means no future release can replace an already installed build.
keystore/
*.jks
*.keystore

# Kotlin session scratch
.kotlin/

# Built extension packages. They are release assets, not source: the script
# stages them itself, and a stale one left in the repo root is a file
# nobody meant to commit and everybody has to remember to delete.
1-download-manager-extension-*.xpi
1-download-manager-extension-*.zip
